# Apache (Beget, Timeweb, REG.RU и другие хостинги с Apache).
# Файл попадает в корень сайта вместе со сборкой.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Перенаправление на HTTPS. Включите (уберите #), когда на домене заработает SSL-сертификат.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Страницы /documents/... и 404 обрабатывает сам сайт: всё, что не файл, отдаём index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Файлы сборки с хешем в имени можно кешировать надолго, index.html — нет
  <FilesMatch "\.(js|css|woff2|webp|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.ftp-deploy-sync-state\.json$">
  Require all denied
</FilesMatch>

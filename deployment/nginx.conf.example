# Template only. Not applied to a live server. Fill the real domain,
# certificate paths and document root; review with your Russian hosting provider.
# The provider must document logs, retention, access, backups and all processors.
server {
    listen 443 ssl;
    server_name YOUR_COMPANY_DOMAIN;
    root /var/www/fortlite/dist/client;
    index index.html;
    ssl_certificate /etc/letsencrypt/live/YOUR_COMPANY_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_COMPANY_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # Enable HSTS only after HTTPS and renewal have been verified:
    # add_header Strict-Transport-Security "max-age=31536000" always;
    # Choose and document access/error log policy with the owner.
    location / { try_files $uri $uri/ /index.html; }
    location /api/ { return 404; }
    location ~ /\. { deny all; }
}
server {
    listen 80;
    server_name YOUR_COMPANY_DOMAIN;
    return 301 https://$host$request_uri;
}
